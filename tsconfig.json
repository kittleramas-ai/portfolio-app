{
  "include": ["**/*.ts", "**/*.tsx", "eslint.config.js", "prettier.config.js", "vite.config.js", "worker-configuration.d.ts"],

  /* bookade-src/ is a 68k-line vendored REFERENCE project, not part of this
     build. It maps its own `@/*` to its internal src/, which does not exist
     here, so every @/server/... import in it is unresolved and typecheck drowns
     in hundreds of phantom errors. Excluded so `tsc` reports only our code. */
  "exclude": ["node_modules", "dist", ".tanstack", ".wrangler", "bookade-src"],

  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
