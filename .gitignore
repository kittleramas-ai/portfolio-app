# The app runs on MySQL now (see DATABASE_URL in .env.local), not on a local
# database file. Nothing database-related belongs in the repo.

# Manager-uploaded images. Written at runtime by the admin panel; committed
# copies would bloat the repo and the files are server state, not source.
public/uploads/

# Generated Cloudflare runtime types (npm run cf:types)
worker-configuration.d.ts
